# Keep the build context small and the image build hermetic: everything below is either rebuilt
# inside the Dockerfile (Gradle/npm outputs, the SPA bundle) or irrelevant to it.
.git/
.gitignore
.idea/
.kotlin/
.gradle/
**/.gradle/
build/
**/build/
**/node_modules/
ui/dist/
docs/
*.md
**/*.md
Dockerfile
.dockerignore
docker-compose*.yml
